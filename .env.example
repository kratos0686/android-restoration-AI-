# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional for Claude 3.7 Sonnet formal IICRC report pipeline (automatic fallback to Gemini).
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# GOOGLE_MAPS_API_KEY: Server & client Google Maps Platform key (auto-provisioned in AI Studio).
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
